<?xml version="1.0" encoding="utf-8"?>
<!-- 本周课表的星期表头行：固定高度，今天一列运行时用主题色高亮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="26dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/week_gutter"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/week_cell1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/week_cell2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/week_cell3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/week_cell4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/week_cell5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/week_cell6"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/week_cell7"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
