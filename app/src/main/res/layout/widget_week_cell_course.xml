<?xml version="1.0" encoding="utf-8"?>
<!--
  周课表课程格的内部内容：课名 + 教师/教室详情行各一条 TextView。
  分别限行并省略——课名最多 2 行、详情行各 1 行（超出在行末省略），
  课名再长也不会折到第 3 行，保证教室信息始终有固定位置不被挤出课程块。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:id="@+id/week_cell_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell_detail1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell_detail2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
