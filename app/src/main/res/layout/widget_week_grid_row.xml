<?xml version="1.0" encoding="utf-8"?>
<!--
  本周课表的课程行：节次号 + 7 列。
  根布局 height=0dp weight=1，由 pushWeek 加入 widget_grid 后按行数均分剩余高度；
  行间距改由课程块背景的 inset 提供（连堂块上下贴合、不同块之间留缝），
  minHeight 只作极端情况的兜底。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:minHeight="22dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/week_gutter"
        android:layout_width="20dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textSize="9sp"
        android:textColor="@color/widget_text_secondary" />

    <TextView
        android:id="@+id/week_cell1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell4"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell5"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell6"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/week_cell7"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:gravity="center"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/widget_on_course"
        android:maxLines="2"
        android:ellipsize="end" />
</LinearLayout>
